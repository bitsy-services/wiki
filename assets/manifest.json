{
  "name": "{{ .Site.Title }}",
  "short_name": "{{ .Site.Title }}",
  "start_url": "{{ "./" | relURL }}",
  "scope": "{{ "./" | relURL }}",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "icons": [
    {
      "src": "{{ "./apple-touch-icon.png" | relURL }}",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "{{ "./favicon.png" | relURL }}",
      "sizes": "1600x1600",
      "type": "image/png"
    }
  ]
}
